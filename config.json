{
  "project": {
    "name": "news_analytics",
    "log_level": "INFO",
    "log_dir": "./logs"
  },
  "qdrant": {
    "host": "127.0.0.1",
    "http_port": 6333,
    "grpc_port": 6334,
    "api_key": "",
    "prefer_grpc": false,
    "timeout": 30
  },
  "collection": {
    "name": "news_embeddings",
    "vector_size": 2048,
    "vector_distance": "Cosine",
    "shard_number": 1,
    "replication_factor": 1,
    "on_disk_payload": true,
    "quantization_enabled": true
  }
}